# Local API port for `npm run dev:api`.
API_PORT="3001"

# Postgres connection string used by the Express API.
# In local development you can keep this in the repo root `.env`.
# In Vercel set it in Project Settings -> Environment Variables.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# VITE_API_URL: Local Express API used by the Vite dev proxy.
VITE_API_URL="http://localhost:3001"

# Public URL used inside password reset emails.
APP_PUBLIC_URL="http://localhost:5173"

# SMTP settings used to send password reset confirmation emails.
# If SMTP_HOST is empty in development, the reset link is printed in the API console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_STARTTLS="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VS Analytics <no-reply@example.com>"
